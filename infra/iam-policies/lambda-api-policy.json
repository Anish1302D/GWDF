{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadPrecomputedApiJsonOnly",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::${DATA_BUCKET}/api/*"
    },
    {
      "Sid": "LambdaCloudWatchLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:ap-south-1:${ACCOUNT_ID}:log-group:/aws/lambda/wellcast-api:*"
    }
  ]
}
