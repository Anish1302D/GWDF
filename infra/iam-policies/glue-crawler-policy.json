{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadRawDataLakeAndForecastsOnly",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::${DATA_BUCKET}",
        "arn:aws:s3:::${DATA_BUCKET}/raw/*",
        "arn:aws:s3:::${DATA_BUCKET}/forecasts/*"
      ]
    }
  ]
}
