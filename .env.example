# WellCast Environment Configuration Template
# Copy to .env and fill with your AWS account / deployment values (never commit .env!)

AWS_PROFILE=wellcast
AWS_REGION=ap-south-1
AWS_ACCOUNT_ID=123456789012

# S3 Buckets (must be globally unique lowercase names)
FORECAST_BUCKET=wellcast-data-123456789012-ap-south-1
WEB_BUCKET=wellcast-web-123456789012-ap-south-1

# Athena & Glue
GLUE_DATABASE=wellcast
ATHENA_WORKGROUP=wellcast-wg

# Lambda Serving Settings
ALLOWED_ORIGIN=https://your-cloudfront-id.cloudfront.net
CACHE_TTL_SECONDS=300
LOCAL_API_DIR=data/processed_local/api

# Frontend Build Variable (see frontend/.env.example)
VITE_API_BASE_URL=http://localhost:8000
