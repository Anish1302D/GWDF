# Local dev uses Vite proxy (/api -> http://127.0.0.1:8000)
# Production CloudFront deploy sets VITE_API_BASE_URL=https://<api-id>.execute-api.ap-southeast-2.amazonaws.com/prod
VITE_API_BASE_URL=/api

# Optional free MapTiler Cloud API key (https://cloud.maptiler.com — 100k free/mo, no credit card).
# Leave empty to use built-in watermark-free Esri Light Gray + OpenStreetMap tiles automatically.
VITE_MAPTILER_KEY=

